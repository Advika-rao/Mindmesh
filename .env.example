# GEMINI_API_KEY: Required server-side environment variable for Gemini AI API calls.
# Configure this in your hosting platform (e.g. Render Environment Variables) without surrounding quotes.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional: Only needed if the frontend is hosted on a different origin than the Express backend.
# Leave unset for single-service full-stack deployments (e.g. Render Web Service).
# VITE_API_BASE_URL=https://your-mindmesh-backend.onrender.com

# APP_URL: The public URL where this app is hosted.
APP_URL=MY_APP_URL
